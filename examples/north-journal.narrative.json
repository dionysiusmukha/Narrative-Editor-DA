  "godot_project_path": "c:\\Dev\\Dark-Alone",
  "characters": [
    {
      "id": "arkadiy",
      "name": "Аркадий",
      "role": "Старший диспетчер Северного створа",
      "biography": "Двадцать два года проработал на узловой сортировке Северного створа. Знает расписание каждого ночного эшелона наизусть. Месяц назад его перевели в архивную смену после исчезновения вагона со спецгрузом.",
      "personality": "Сдержанный, недоверчивый, говорит сухо и по делу. Не любит суеты, всегда садится у правого края стойки, чтобы видеть вход.",
      "motivation": "Понять, проверяет ли его бармен по заданию инспекции, и решить — можно ли оставить в баре ключ от закрытого ящика с путевыми листами.",
      "secrets": "В ночь аварии на Тупиковой ветке Аркадий лично перевёл стрелку по устному приказу сверху, а оригинал журнала дежурств спрятал под обшивкой в подсобке.",
      "default_emotion": "tense",
      "available_emotions": [
        "neutral",
        "interested",
        "thoughtful",
        "tense",
        "disagree"
      ],
      "preferences": [
        "test_stvor",
        "test_shot"
      ],
      "avatar_color": "#38bdf8",
      "relationships": [
        {
          "target_id": "bartender",
          "trust": 0,
          "conflict": 2,
          "hidden": false,
          "note": "Изучает нового бармена: проверяет, помнит ли тот старые привычки железнодорожников."
        },
        {
          "target_id": "inspector_voronov",
          "trust": -5,
          "conflict": 8,
          "hidden": true,
          "note": "Боится ревизии Воронова после инцидента на Тупиковой ветке."
        }
      ]
    },
    {
      "id": "bartender",
      "name": "Бармен",
      "role": "Хозяин ночной смены",
      "biography": "Ведёт ночные смены в баре у сортировочной станции. Слушает гостей, ведёт личный дневник наблюдений.",
      "personality": "Немногословный, внимательный к деталям.",
      "motivation": "Собрать картину происходящего в районе из обрывков чужих разговоров.",
      "secrets": "Хранит записи о каждом госте в личном бумажном дневнике.",
      "default_emotion": "neutral",
      "available_emotions": [
        "neutral",
        "thoughtful"
      ],
      "preferences": [
        "test_water"
      ],
      "avatar_color": "#94a3b8",
      "relationships": []
    },
    {
      "id": "inspector_voronov",
      "name": "Инспектор Воронов",
      "role": "Следователь линейного контроля",
      "biography": "Курирует расследование пропавших составов на Северном створе.",
      "personality": "Холодный, методичный, давит молчанием.",
      "motivation": "Найти пропавший журнал ночной диспетчерской.",
      "secrets": "Его подпись стоит на закрытом допуске того самого состава.",
      "default_emotion": "tense",
