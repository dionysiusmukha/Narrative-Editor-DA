{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 80
    },
    "test_content": {
      "type": "boolean"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      },
      "minItems": 1,
      "maxItems": 128
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      },
      "minItems": 0,
      "maxItems": 512
    },
    "interactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interaction"
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "required": [
    "schema_version",
    "id",
    "test_content",
    "pages",
    "connections",
    "interactions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "condition": {
      "type": "object",
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "conclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "font_size": {
          "type": "integer",
          "minimum": 22,
          "maximum": 48
        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "contour": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 128
        },
        "arrow": {
          "type": "boolean"
        },
        "curve": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "type": {
          "enum": [
            "quote",
            "term",
            "group",
            "conclusion",
            "page_link"
          ]
        },
        "reference_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "reveal_condition": {
          "$ref": "#/$defs/condition"
        }
      },
      "required": [
        "id",
        "type",
        "reference_id",
        "position",
        "size",
        "style",
        "reveal_condition"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "section": {
          "enum": [
            "notes",
            "words"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "reveal_condition": {
          "$ref": "#/$defs/condition"
        }
      },
      "required": [
        "id",
        "section",
        "title",
        "order",
        "elements",
        "reveal_condition"
      ],
      "additionalProperties": false
    },
    "connection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "target_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "path_points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2,
          "maxItems": 128
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "activation_condition": {
          "$ref": "#/$defs/condition"
        }
      },
      "required": [
        "id",
        "source_id",
        "target_id",
        "path_points",
        "style",
        "activation_condition"
      ],
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "type": {
          "enum": [
            "compare",
            "connect",
            "revise"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 80
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 8
        },
        "activation_condition": {
          "$ref": "#/$defs/condition"
        },
        "strike_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "type",
        "source_ids",
        "options",
        "activation_condition",
        "strike_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "revise"
              }
            }
          },
          "then": {
            "properties": {
              "source_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "options": {
                "minItems": 2,
                "maxItems": 8
              }
            }
          },
          "else": {
            "properties": {
              "source_ids": {
                "minItems": 2,
                "maxItems": 2
              },
              "options": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
