  "dialogues": [
    {
      "id": "arkadiy_intro",
      "character_id": "inspector_voronov",
      "title": "Аркадий: Разговор после смены",
      "start_node": "opening",
      "allow_cycles": false,
      "test_content": false,
      "nodes": [
        {
          "id": "opening",
          "speaker": "Аркадий",
          "character_id": "arkadiy",
          "emotion": "tense",
          "text": "Сыро сегодня у переезда. Налей чего-нибудь простого, без ваших новых смесей. На **Северный створ** теперь мало кто заглядывает, но старую привычку за месяц не вытравишь.",
          "end": false,
          "position": {
            "x": -12.495997350213088,
            "y": 236.99839894008534
          },
          "notes": "Стартовая реплика Аркадия. Выдаёт термин northern_stvor.",
          "effects": [
            {
              "effect_id": "grant_northern_stvor",
              "type": "grant_term",
              "term_id": "northern_stvor"
            },
            {
              "effect_id": "mark_drink_hint",
              "type": "set_variable",
              "variable_id": "arkadiy_ordered_stvor",
              "value": true
            }
          ],
          "choices": [
            {
              "id": "respect_habit",
              "text": "Чистый «Северный створ» в рюмке? Сейчас таких гостей почти не осталось.",
              "target": "warm_up",
              "required_terms": [],
              "required_conclusions": [],
              "conditions": []
            },
            {
              "id": "ask_transfer_direct",
              "text": "Говорят, тебя сняли с линии месяц назад. Что там стряслось?",
              "target": "defensive_reply",
              "required_terms": [],
              "required_conclusions": [],
              "conditions": []
            }
          ]
        },
        {
          "id": "warm_up",
          "speaker": "Аркадий",
          "character_id": "arkadiy",
          "emotion": "interested",
          "text": "Вижу, глаз у тебя намётанный. Когда двадцать лет сидишь в **ночной диспетчерской**, по одному стуку колёс понимаешь, порожний идёт или гружёный.",
          "end": false,
          "position": {
            "x": 531.3678742488279,
            "y": -79.47108738226785
          },
          "notes": "Игрок проявил уважение — доверие Аркадия растёт (+2).",
          "effects": [
            {
              "effect_id": "grant_night_dispatch",
              "type": "grant_term",
              "term_id": "night_dispatch"
            },
            {
              "effect_id": "trust_up_warm",
              "type": "add_variable",
              "variable_id": "arkadiy_trust",
              "value": 2
            },
            {
              "effect_id": "mood_open_warm",
              "type": "set_variable",
              "variable_id": "arkadiy_mood",
              "value": "open"
            },
            {
              "effect_id": "request_stvor_shot",
              "type": "service_event",
              "event": "request_drink",
              "arg": "test_stvor"
            }
          ],
          "choices": [
            {
              "id": "ask_about_night_train",
              "text": "И какой же состав прошёл мимо тебя месяц назад?",
              "target": "siding_story",
              "required_terms": [
                "northern_stvor"
              ],
              "required_conclusions": [],
              "conditions": [
                {
                  "variable_id": "arkadiy_trust",
                  "op": ">=",
                  "value": 1
                }
              ]
            },
            {
              "id": "keep_quiet_toast",
              "text": "Меньше знаешь — крепче спишь. За спокойную смену.",
              "target": "calm_goodbye",
              "required_terms": [],
              "required_conclusions": [],
              "conditions": []
            }
          ]
        },
        {
          "id": "defensive_reply",
          "speaker": "Аркадий",
          "character_id": "arkadiy",
          "emotion": "disagree",
          "text": "Много говорят. В **ночной диспетчерской** лишние вопросы задавать не принято, особенно когда за стойкой незнакомый человек.",
          "end": false,
          "position": {
            "x": 556.9983989400853,
            "y": 436.58578661424815
          },
          "notes": "Игрок надавил слишком рано — доверие падает (-1).",
          "effects": [
            {
              "effect_id": "grant_dispatch_defensive",
              "type": "grant_term",
              "term_id": "night_dispatch"
            },
            {
              "effect_id": "trust_down_press",
              "type": "add_variable",
              "variable_id": "arkadiy_trust",
              "value": -1
            },
            {
              "effect_id": "mood_suspicious",
              "type": "set_variable",
              "variable_id": "arkadiy_mood",
              "value": "suspicious"
            }
          ],
          "choices": [
            {
              "id": "apologize_back_off",
              "text": "Не бери в голову, я не из инспекции. Просто поддерживаю разговор.",
              "target": "siding_story",
              "required_terms": [],
              "required_conclusions": [],
              "conditions": []
            },
            {
              "id": "end_tense",
              "text": "Ладно, не будем о работе.",
              "target": "cold_goodbye",
              "required_terms": [],
              "required_conclusions": [],
              "conditions": []
            }
          ]
        },
        {
          "id": "siding_story",
          "speaker": "Аркадий",
          "character_id": "arkadiy",
          "emotion": "thoughtful",
          "text": "За депо есть старая **тупиковая ветка**. По бумагам она разобрана ещё три года назад. Только рельсы там блестят так, будто каждую неделю металл возят.",
          "end": false,
          "position": {
            "x": 1116.407929655898,
            "y": -49.739670999407
          },
          "effects": [
            {
              "effect_id": "grant_blind_siding",
              "type": "grant_term",
              "term_id": "blind_siding"
            }
          ],
          "choices": [
            {
              "id": "trusted_archive_question",
              "text": "Ты ведь сохранил путевой лист той ночи, верно?",
              "target": "secret_archive_reveal",
              "required_terms": [
                "night_dispatch",
                "blind_siding"
              ],
              "required_conclusions": [],
              "conditions": [
                {
                  "variable_id": "arkadiy_trust",
                  "op": ">=",
                  "value": 2
                }
              ]
            },
            {
              "id": "deduction_witness_branch",
              "text": "Тебя перевели с линии, потому что ты видел, кто принимал этот состав.",
              "target": "secret_archive_reveal",
              "required_terms": [
                "blind_siding"
              ],
              "required_conclusions": [
                "arkadiy_fears_inspection"
              ],
              "conditions": []
            },
            {
              "id": "safe_wrap_up",
              "text": "Пей, пока не выдохлось. На улице ветер крепчает.",
              "target": "calm_goodbye",
              "required_terms": [],
              "required_conclusions": [],
              "conditions": []
            }
          ]
        },
        {
          "id": "secret_archive_reveal",
          "speaker": "Аркадий",
          "character_id": "arkadiy",
          "emotion": "thoughtful",
          "text": "Тише ты… Меня посадили в **опечатанный архив**, думали — списали старика. А я ведь дубликат журнала под обшивкой оставил. Если со мной что случится — ищи за старым распределительным щитом.",
          "end": true,
          "position": {
            "x": 1771.5844287929456,
            "y": 88.71745887492585
          },
          "notes": "Секретный финал разговора при высоком доверии или выводе в дневнике.",
          "effects": [
            {
              "effect_id": "grant_sealed_archive",
              "type": "grant_term",
              "term_id": "sealed_archive"
            },
            {
              "effect_id": "flag_secret_shared",
