              "variable_id": "arkadiy_shared_secret",
              "value": true
            },
            {
              "effect_id": "trust_max_bonus",
              "type": "add_variable",
              "variable_id": "arkadiy_trust",
              "value": 2
            }
          ],
          "choices": []
        },
        {
          "id": "calm_goodbye",
          "speaker": "Аркадий",
          "character_id": "arkadiy",
          "emotion": "neutral",
          "text": "Спасибо за тишину, бармен. В следующий раз загляну, когда смена уляжется.",
          "end": true,
          "position": {
            "x": 1306.3615950191465,
            "y": 601.839981824066
          },
          "effects": [],
          "choices": []
        },
        {
          "id": "cold_goodbye",
          "speaker": "Аркадий",
          "character_id": "arkadiy",
          "emotion": "tense",
          "text": "Бывай. И не советую расспрашивать людей о том, что тебя не касается.",
